@page
@model Assignment01_RazorPages.Pages.Shows.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Show</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Date
        </dt>
        <dd class="col-sm-10" id="showDate">
        </dd>
        <dt class="col-sm-2">
            Price
        </dt>
        <dd class="col-sm-10" id="price">
        </dd>
        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10" id="status">
        </dd>
        <dt class="col-sm-2">
            Slot
        </dt>
        <dd class="col-sm-10" id="slot">
        </dd>
        <dt class="col-sm-2">
            Title
        </dt>
        <dd class="col-sm-10" id="title">
        </dd>
        <dt class="col-sm-2">
            Country Name
        </dt>
        <dd class="col-sm-10" id="countryName">
        </dd>
        <dt class="col-sm-2">
            Room name
        </dt>
        <dd class="col-sm-10" id="roomId">
        </dd>
    </dl>
    
    <a id="backToList" src="" class="btn btn-primary">Back To List</a>
</div>

<script src="~/lib/jquery/jquery.min.js"></script>
<script>
    $(document).ready(async function () {
        const API_BASE_URL = 'https://localhost:7196';

        async function getShowById(showId) {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: `${API_BASE_URL}/odata/show/${showId}`,
                    type: 'GET',
                    success: function (data) {
                        resolve(data);
                    },
                    error: function (error) {
                        reject(error);
                    }
                });
            });
        }

        async function getFilmById(filmId) {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: `${API_BASE_URL}/odata/film/${filmId}`,
                    type: 'GET',
                    success: function (data) {
                        resolve(data);
                    },
                    error: function (error) {
                        reject(error);
                    }
                });
            });
        }

        async function getCountryById(countryId) {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: `${API_BASE_URL}/api/country/${countryId}`,
                    type: 'GET',
                    success: function (data) {
                        resolve(data);
                    },
                    error: function (error) {
                        reject(error);
                    }
                });
            });
        }

        const urlParams = new URLSearchParams(window.location.search);
        const showId = urlParams.get('id');

        try {
            const showData = await getShowById(showId);

            $('#showDate').html(showData.ShowDate);
            $('#price').html(showData.Price);
            $('#status').html(showData.Status);
            $('#slot').html(showData.Slot);

            const film = await getFilmById(showData.FilmID);

            const country = await getCountryById(film.CountryCode);

            $('#title').html(film.Title);
            $('#countryName').html(country.countryName);
            $('#roomId').html(showData.RoomID);

            $('#backToList').click(function() {
                window.location.href = `/Shows/Index?selectedRoomId=${$('#roomId').html()}&showDate=${$('#showDate').html()}`;
            });
        } catch (error) {
            console.error("Error fetching data:", error);
        }
    })
</script>

